(meta task-s1-iroh-transport
  (phase "S")
  (description "shell/transport.rs: iroh endpoint, direct connection, bidirectional control stream carrying CON-015 envelopes; broadcast local deltas, apply remote deltas to CollabDoc. Implements REQ-071, REQ-084.")
  (acceptance "Local commit appears on a connected peer via incremental delta (no full resend); message-inspection confirms DELTA framing (TEST-103)"))

(meta task-s2-rendezvous-spake2
  (phase "S")
  (description "shell/pairing.rs: rendezvous client (CON-014), SPAKE2 live handshake keyed by the parsed Phrase, NodeTicket exchange, handoff to direct iroh, channel lockout. NO-GO crypto area: audited impl + human expert + cross-model review required. Implements REQ-068, REQ-069, REQ-070, REQ-071, NFR-014.")
  (acceptance "Matching phrase -> direct connection; wrong phrase -> fail closed, no project bytes; rendezvous never sees key/data (TEST-079, TEST-080, TEST-081, TEST-117)"))

(meta task-s3-blob-sync
  (phase "S")
  (description "shell/sync.rs: iroh-blobs content-addressed media + derived-artefact replication; integrity gate (recompute blake3 before writing to sources/, quarantine on mismatch); sync-before-edit gating + progress. Implements REQ-075, REQ-076, REQ-077, REQ-078.")
  (acceptance "Missing blobs transfer, identical-hash skip, resume across reconnect; corrupted blob rejected/never written; edit gated until synced (TEST-087, TEST-089, TEST-091)"))

(meta task-s4-presence
  (phase "S")
  (description "shell/presence.rs: ephemeral peer presence + membership lifecycle over CON-015 PRESENCE frames; never persisted to the edit doc. Implements REQ-073, REQ-085.")
  (acceptance "Peers see connected set + selected shot; presence disappears on disconnect; not persisted (TEST-084, TEST-104)"))

(meta task-s5-offline-reconnect
  (phase "S")
  (description "shell/reconnect.rs: version-vector delta sync; offline edits accumulate and converge on reconnect with delta-only exchange. Implements REQ-087.")
  (acceptance "Offline edits converge on reconnect, no loss, no full resend (TEST-107, TEST-108)"))

(meta task-s6-cli
  (phase "S")
  (description "ar-edit binary: ar-edit share / pair <phrase> / session status|peers|leave wired to the shell; --json output per CON-012; phrase rejected before any network action. Implements CON-012, surfaces REQ-067..073.")
  (acceptance "CLI commands match CON-012 contracts incl. exit codes; malformed phrase exits 1 with no socket opened (TEST-078)"))

(meta task-s7-rendezvous-server
  (phase "S")
  (description "Standalone rendezvous server binary implementing CON-014: channel match, opaque PAKE/ticket relay, frame-length cap, error model. Never interprets project data. Deployment model is SPEC-003 OQ-3.")
  (acceptance "Two clients match on a channel and complete handshake relay; server observes zero project bytes; oversized/unknown frames rejected (TEST-081)"))

;; Phase S readiness — each needs the pure core it builds on AND the (external)

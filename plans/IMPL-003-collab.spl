;; =============================================================================
;; IMPL-003: Realtime Collaborative Editing via P2P CRDTs
;; Implementation plan derived from SPEC-003 (ADR-007..012, CON-012..016).
;; Two phases:
;;   P (pure core)  — Loro CRDT model, migration, LangSec recognisers,
;;                    reconciliation, per-actor undo. Buildable now: depends
;;                    only on loro/blake3/spake2 + ar-edit-core (no iroh).
;;   S (shell)      — iroh transport, rendezvous, SPAKE2 live, blob sync,
;;                    presence, CLI, rendezvous server. BLOCKED on this host:
;;                    the iroh/quinn/rustls build tree + 2 GB transfer exceed
;;                    available disk (~700 MB). Tracked under SPEC-003 OQ-7.
;; =============================================================================

(meta plan
  (id "IMPL-003")
  (title "Realtime Collaborative Editing via P2P CRDTs")
  (version "1.0.0")
  (status "active")
  (created "2026-06-18")
  (author "agent:claude")
  (spec "SPEC-003")
  (description "Reformulate the edit document as a Loro CRDT and add p2p collaboration. Phase P (pure core, 9 tasks) is buildable now and verified with property/fuzz tests; Phase S (effectful shell, 7 tasks) is blocked on disk/transport (OQ-7) and scaffolded behind trait boundaries."))

;; =============================================================================
;; Agent
;; =============================================================================

(given agent-claude-available)

;; =============================================================================
;; PHASE P: Pure Core (buildable now — no iroh, no network, no disk transfer)
;; Purity Boundary Map "pure core": CRDT merge/materialise, recognisers,
;; reconciliation, migration. Dependencies: loro, blake3, spake2, ar-edit-core.
;; =============================================================================

(given task-p0-scaffold)
(given no-deps-p0-scaffold)
(given task-p1-crdt-model)
(given task-p2-materialise)
(given task-p3-migrate)
(given task-p4-undo)
(given task-p5-phrase)
(given task-p6-wire)
(given task-p7-reconcile)
(given task-p8-tests)

(meta task-p0-scaffold
  (phase "P")
  (description "Create crate crates/ar-edit-collab; add to workspace members; add workspace deps loro=1, blake3=1, spake2=0.4; depend on ar-edit-core. Module layout per SPEC-003 Purity Boundary Map: core/ (pure: crdt, materialise, migrate, recognise, reconcile, ids) and shell/ (effectful, stubs for now). lib.rs re-exports core. Add a module-level doc comment stating the dependency rule (core MUST NOT import shell or iroh) and a #[cfg(test)] arch guard or comment. Ensures cargo build -p ar-edit-collab compiles without pulling the iroh tree.")
  (acceptance "cargo build -p ar-edit-collab succeeds; ar-edit-collab depends on ar-edit-core but NOT on iroh/tokio; core modules compile with zero I/O imports"))

(meta task-p1-crdt-model
  (phase "P")
  (description "core/crdt.rs: model the edit document as a Loro doc. Shot ORDER as a MovableList<shot-id> (string ids); per-shot fields (source, range) in a top-level LoroMap keyed by shot-id; notes as an append-only LoroList keyed per shot; markers and POIs as LoroMaps keyed by stable id (observed-remove via Loro deletion). Public API: CollabDoc::new(actor_id), add_shot/remove_shot/move_shot/trim_shot/add_note mutators that mirror ar-edit-core::edit semantics but commit to Loro; export_snapshot()->Vec<u8>, import(&[u8]), version()->VersionVector, export_from(&vv)->delta bytes. Range serialised to match ar-edit-core ShotRange (externally-tagged lowercase). Implements REQ-079, REQ-080, REQ-081, REQ-082.")
  (acceptance "Mutators build a Loro doc; move preserves shot id (no delete+insert); export/import round-trips; two docs sharing changes converge (deep value equal)"))

(meta task-p2-materialise
  (phase "P")
  (description "core/materialise.rs: pure fn materialise(&CollabDoc) -> ar_edit_core::models::EditSnapshot (and a to_edit_document() producing the on-disk JSON view). Reads the MovableList order, joins per-shot field maps and notes, reconstructs Vec<Shot> with id/source/range/notes. Deterministic: same CRDT state -> identical EditSnapshot. Implements REQ-079.")
  (acceptance "materialise is a pure deterministic function; output Shot order matches MovableList order; ranges/notes reconstructed; JSON equals the equivalent single-player snapshot (TEST-092, TEST-093)"))

(meta task-p3-migrate
  (phase "P")
  (description "core/migrate.rs: pure fn from_event_sourced(&EditDocument) -> CollabDoc. Replay ops[0..=head] (or use the cached snapshot) into a fresh one-actor CollabDoc such that materialise(result) == input.snapshot. Single-player path: a one-actor CollabDoc is the canonical form (REQ-088). Implements REQ-088, supports ADR-011.")
  (acceptance "For fixture event-sourced docs, materialise(from_event_sourced(d)) == d.snapshot exactly (TEST-109); one-actor doc behaves identically to single-player (TEST-110)"))

(meta task-p4-undo
  (phase "P")
  (description "core/undo.rs: wrap Loro UndoManager scoped to the local actor. undo()/redo() revert/replay only the local actor's own changes, producing inverse changes that propagate as ordinary deltas. Redefines REQ-046/047 for collaborative mode. Implements REQ-086.")
  (acceptance "Local undo reverts only local changes, never a remote actor's change (TEST-105, TEST-106); single-actor undo/redo observationally matches existing head-pointer behaviour"))

(meta task-p5-phrase
  (phase "P")
  (description "core/recognise/phrase.rs: LangSec recogniser for the pairing phrase per CON-013 ABNF (channel '-' word '-' word). Compile an audited wordlist (PGP word list or >=256 phonetically-distinct words) at build time. parse(&str)->Result<Phrase{channel:u16, words:[WordId;2]}, ParseError>: verify channel in 0..=999 and each word in wordlist; NO normalisation/repair; reject malformed before emitting typed value. Also generate(rng)->Phrase using a CSPRNG for REQ-067. Implements REQ-067, REQ-069 (parse side), CON-013.")
  (acceptance "Valid phrases parse to typed Phrase; malformed/non-wordlist/out-of-range rejected with no side effect; generator emits grammar-conformant phrases from CSPRNG (TEST-074, TEST-075)"))

(meta task-p6-wire
  (phase "P")
  (description "core/recognise/wire.rs: LangSec recognisers for the length-prefixed, externally-tagged frames of CON-014 (rendezvous), CON-015 (sync envelope: version+tag+payload, version mismatch rejected), CON-016 (source-sync: MANIFEST/WANT/HAVE/CONFLICT, blake3-hash exactly 32 octets). Each: parse &[u8]->Result<Frame, ParseError> with a max-length cap (default 64 KiB) rejected without buffering; unknown tag/version -> error, no partial dispatch. DELTA/PAKE/TICKET payloads remain opaque bytes. Implements CON-014, CON-015, CON-016 recognition; supports REQ-070/084/074/076.")
  (acceptance "Well-formed frames parse to typed enums; oversized/unknown-tag/short-hash/version-mismatch frames rejected fail-closed; fuzzing the parsers finds no panic and no accept-should-reject (TEST-075 pattern extended)"))

(meta task-p7-reconcile
  (phase "P")
  (description "core/reconcile.rs + core/ids.rs: (1) reconcile(local_manifest, remote_manifest) -> Result<MergedManifest, Conflict> mapping each src-id to one blake3 hash; same id + different hash => Conflict (no silent overwrite) per REQ-074. (2) blake3 integrity helper verify_blob(expected:&Hash, bytes:&[u8])->bool for REQ-076 (pure; the receive/quarantine I/O is shell). (3) actor-id ordering: derive ActorId from a node public key; total_order over concurrent changes by actor id for deterministic tie-break (REQ-072), without implying causality. Implements REQ-072, REQ-074, REQ-076 (pure parts).")
  (acceptance "Reconciliation merges disjoint/identical inventories; same-id/different-hash yields Conflict; verify_blob accepts matching, rejects mismatched; actor-id order is total and deterministic (TEST-082, TEST-083, TEST-085, TEST-086, TEST-088, TEST-089 pure parts)"))

(meta task-p8-tests
  (phase "P")
  (description "tests/: property + example tests for the pure core. Convergence/SEC: concurrent insert/move/move-same/move+field/3-peer different-orders -> deep-value equality (TEST-094..102, TEST-101 SEC). Migration snapshot identity (TEST-109, TEST-110). Per-actor undo (TEST-105, TEST-106). Recogniser fuzz/negative (TEST-075, TEST-078, plus CON-015/016 negatives). Reconciliation + integrity (TEST-085/086/088/089). Use deterministic seeds; no network, no whisper/ffmpeg. Implements the pure-core slice of the SPEC-003 traceability matrix.")
  (acceptance "cargo test -p ar-edit-collab is green; every pure-core REQ has >=1 passing test per applicable type; convergence properties hold across randomized orderings"))

;; Phase P readiness
(normally r-ready-p0-scaffold (and task-p0-scaffold no-deps-p0-scaffold) ready-p0-scaffold)
(normally r-ready-p1-crdt-model (and task-p1-crdt-model completed-p0-scaffold) ready-p1-crdt-model)
(normally r-ready-p2-materialise (and task-p2-materialise completed-p1-crdt-model) ready-p2-materialise)
(normally r-ready-p3-migrate (and task-p3-migrate completed-p2-materialise) ready-p3-migrate)
(normally r-ready-p4-undo (and task-p4-undo completed-p1-crdt-model) ready-p4-undo)
(normally r-ready-p5-phrase (and task-p5-phrase completed-p0-scaffold) ready-p5-phrase)
(normally r-ready-p6-wire (and task-p6-wire completed-p0-scaffold) ready-p6-wire)
(normally r-ready-p7-reconcile (and task-p7-reconcile completed-p0-scaffold) ready-p7-reconcile)
(normally r-ready-p8-tests (and task-p8-tests completed-p2-materialise completed-p3-migrate completed-p4-undo completed-p5-phrase completed-p6-wire completed-p7-reconcile) ready-p8-tests)


(normally r-assign-c3 (and ready-c3-edit-show agent-claude-available) assign-to-c3-edit-show-claude)
(normally r-assign-c4 (and ready-c4-tests-display agent-claude-available) assign-to-c4-tests-display-claude)

;; Phase D
(normally r-assign-d1 (and ready-d1-tui-poi agent-claude-available) assign-to-d1-tui-poi-claude)
(normally r-assign-d2 (and ready-d2-playback-poi agent-claude-available) assign-to-d2-playback-poi-claude)

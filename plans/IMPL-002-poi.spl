;; =============================================================================
;; Rule metadata
;; =============================================================================

(meta r-ready-a1-model
  (description "Model types have no dependencies — can start immediately")
  (justification "PoiPoint, PoiCategory, Poi, SourcePois are pure data types"))

(meta r-ready-a2-poi-module
  (description "POI CRUD requires model types")
  (justification "poi.rs uses Poi, PoiPoint, PoiCategory, SourcePois from models"))

(meta r-ready-a3-resolve
  (description "Point resolution requires model types")
  (justification "resolve_poi_point takes PoiPoint and returns ms"))

(meta r-ready-a4-tests-core
  (description "Core tests require both CRUD and resolution")
  (justification "TEST-059..061,071 exercise poi.rs and resolve functions"))

(meta r-ready-b1-cli-args
  (description "CLI arg structs require model types for PoiCategory validation")
  (justification "Clap args reference PoiCategory and PoiPoint variants"))

(meta r-ready-b2-cli-dispatch
  (description "CLI dispatch requires core module, resolution, and parsed args")
  (justification "Handlers call poi::add_poi, resolve_poi_point, use CLI arg structs"))

(meta r-ready-c1-interleave
  (description "Interleaving requires resolved POIs")
  (justification "Pure function merging ResolvedPoi into transcript word stream"))

(meta r-ready-d1-tui-poi
  (description "TUI POI creation requires core module and CLI dispatch pattern")
  (justification "TUI calls same core functions as CLI, needs dispatch wired"))


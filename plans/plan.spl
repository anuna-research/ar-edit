(given task-i2-errors)
(given task-i3-completions)
(given task-i4-schema)

(meta task-i1-e2e
  (phase "I")
  (description "Write E2E test script tests/e2e/test_full_pipeline.sh: init -> add (fixture videos) -> transcribe -> edit create -> add-segment -> move-segment -> trim-segment -> validate -> play -> render -o out.mp4 -> verify output duration/codec. Uses real fixture videos.")
  (acceptance "Full pipeline completes exit 0; output video has correct duration; codec matches expected"))

(meta task-i2-errors
  (phase "I")
  (description "Review and polish all error messages across CLI and core: consistent formatting, actionable suggestions (e.g. 'run ar-edit doctor to check dependencies'), helpful context. Verify CON-009 exit codes are correct in all error paths. No raw panics exposed to users.")
  (acceptance "All error messages include actionable next steps; exit codes consistent with CON-009; no panic messages visible"))

(meta task-i3-completions
  (phase "I")
  (description "Generate shell completions via clap_complete for bash, zsh, and fish. Either build-time generation or runtime via ar-edit completions generate <shell>.")
  (acceptance "Completions work in bash, zsh, and fish; all subcommands, flags, and source-id arguments completed"))

(meta task-i4-schema
  (phase "I")
  (description "Implement ar-edit schema edit: output JSON Schema for the edit document format. Schema should validate the examples from DATA-MODEL.md. Implements REQ-019.")
  (acceptance "Valid JSON Schema output; schema correctly validates example edit documents"))

;; Phase I readiness
(normally r-ready-i1-e2e (and task-i1-e2e completed-f6-tests completed-g4-tests completed-h9-tests) ready-i1-e2e)

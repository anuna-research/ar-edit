;; =============================================================================
;; PHASE J: Markers and Annotations
;; Delivers: ar-edit mark, ar-edit markers, shot notes
;; (runs in parallel with later phases, depends on B + C)
;; =============================================================================

(given task-j1-markers)
(given task-j2-listing)
(given task-j3-notes)
(given task-j4-integrate)
(given task-j5-tests)

(meta task-j1-markers
  (phase "J")
  (description "Implement source marker creation per DATA-MODEL section 5: ar-edit mark <source-id> with --from-word/--to-word, --from-scene/--to-scene, or --from-ms/--to-ms range, --label <label> (select/hero/avoid/maybe/freeform), optional --note. Store in annotations/src-NNN.markers.json. Sequential marker IDs (mark-NNN). Implements REQ-049.")
  (acceptance "Markers created with correct range, label, note; stored in annotations/; IDs sequential; range uses ShotRange tagged union"))

(meta task-j2-listing
  (phase "J")
  (description "Implement ar-edit markers [<source-id>] [--label <filter>]: list markers showing marker ID, source, label, note, resolved time range, transcript/scene text at that range. --json support per CON-003 patterns. Implements REQ-050.")
  (acceptance "Lists all markers or filtered by source/label; includes resolved timestamps and text at range"))

(meta task-j3-notes
  (phase "J")
  (description "Implement ar-edit edit note <edit> --shot <shot-id> --text <note>: append note to shot's notes array (append-only, never deleted). Notes visible in ar-edit edit show --json output. Per DATA-MODEL section 5 shot notes. Implements REQ-051, REQ-053.")
  (acceptance "Notes appended to shot; visible in show --json output; never deleted; timestamps recorded"))

(meta task-j4-integrate
  (phase "J")
  (description "Implement marker interleaving for agent consumption: ar-edit markers --json outputs markers with resolved context; ar-edit transcripts read <source-id> --json --with-markers interleaves markers at their timestamp positions. Implements REQ-052.")
  (acceptance "Markers interleaved at correct timestamp positions in transcript output; agent can parse marker context for edit assembly"))

(meta task-j5-tests
  (phase "J")
  (description "Write tests TEST-054 (marker creation), TEST-055 (marker listing with filters), TEST-056 (shot notes append-only), TEST-057 (agent reads markers in transcript), TEST-058 (agent reads shot notes in edit show).")
  (acceptance "All 5 tests pass"))

;; Phase J readiness (depends on A models, C resolve/ops, B transcript ops)
(normally r-ready-j1-markers (and task-j1-markers completed-a2-models completed-c4-resolve) ready-j1-markers)

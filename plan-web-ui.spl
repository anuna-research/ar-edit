(normally r-propagate-source-browser-from-frontend-scaffold-stale-v1 stale-v1-frontend-scaffold upstream-blocked-source-browser)
(normally r-propagate-source-browser-from-frontend-scaffold-timeout-v1 timeout-v1-frontend-scaffold upstream-blocked-source-browser)
(normally r-propagate-timeline-from-frontend-scaffold-failed failed-frontend-scaffold upstream-blocked-timeline)
(normally r-propagate-timeline-from-frontend-scaffold-permanently-failed permanently-failed-frontend-scaffold upstream-blocked-timeline)
(normally r-propagate-timeline-from-frontend-scaffold-stale-v1 stale-v1-frontend-scaffold upstream-blocked-timeline)
(normally r-propagate-timeline-from-frontend-scaffold-timeout-v1 timeout-v1-frontend-scaffold upstream-blocked-timeline)

(claims agent:claude
  :at "2026-03-15T05:46:46Z"
  (given completed-frontend-scaffold))

(claims agent:claude
  :at "2026-03-15T05:46:49Z"
